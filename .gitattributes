# Line-ending policy
#
# scripts/sync-script-docs.mjs generates Markdown with LF line endings, and
# `docs:scripts:check` (run in `prebuild`) compares that generated output
# against the working copy. On Windows, core.autocrlf=true checks Markdown out
# as CRLF, so the verifier reports a false "out of sync". Pinning Markdown to
# LF keeps the working copy, the committed blob, and the generator in agreement
# on every platform.
*.md text eol=lf

# Golden serializer fixtures (src/app/golden-workspace.test.ts) pin the
# byte-exact output of the dual-use storage serializers. They must never be
# touched by line-ending conversion — `-text` makes git treat them as binary
# for eol purposes, so the working copy always matches the committed blob
# byte-for-byte on every platform. (This also overrides the `*.md eol=lf`
# rule above for the .md fixture.)
src/app/__fixtures__/golden-workspace.csv -text
src/app/__fixtures__/golden-workspace.md -text

# The operating-guide builtin is emitted by scripts/gen-operating-guide.mjs,
# which normalizes its output to LF. Pin the committed + working copy to LF so
# core.autocrlf can't check it out as CRLF and make `prebuild`'s regeneration
# see phantom line-ending drift against the freshly generated LF file.
src/app/operating-guide-builtin.generated.ts text eol=lf
