# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# ★ Anchored `/node_modules` above covers the ROOT install only. Subtrees with
# their own package.json (desktop/) install their own, and an unignored one is
# hundreds of MB of untracked files in a worktree that other sessions share --
# one `git add -A` away from being committed. This bare pattern matches at any
# depth and subsumes the anchored line above; the anchored line is kept so the
# root case stays obvious.
node_modules/

# Compiler output for the desktop/ subtree (tsc -p desktop/tsconfig.json emits here)
desktop/dist/
# electron-builder packaging output (installers, unpacked app trees) -- large,
# machine-specific, and rebuilt from desktop:package; never tracked.
desktop/release/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache
/blob-report
/.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
/.claude
/.reports

# skills
/.superpowers/

# local sample / pattern artifacts (not part of the repo)
/docs/patterns/

# local Turso tooling + databases (downloaded binaries / local data — not part of the repo)
/tursodb.exe
/turso_cli-installer.ps1
*.db
*.db-shm
*.db-wal
# WAL/SHM sidecars of the committed sample DB are transient — the .sqlite3 itself
# is committed (in WAL journal mode) but its sidecars must never be.
*.sqlite3-shm
*.sqlite3-wal
# Local UI-demo recorder artifacts (not part of the repo)
/demo/
/.demo-tmp/

# Archived slice-doc bundles. Kept on disk deliberately, but binaries do not
# belong in git history — once committed they inflate every future clone forever.
/docs/superpowers/_archive-slice-docs-*.zip

# Agent-skill tooling artifacts (installed skills + lockfile — not part of the app)
/.agents/
/skills-lock.json

# OpenSpec working directory (not part of the app)
/openspec/

# Superpowers worktrees
/.worktrees/
